    "import random\n",
    "import string\n",
    "\n",
    "length = int(input(\"Enter the password length: \"))\n",
    "\n",
    "characters = string.ascii_letters + string.digits\n",
    "\n",
    "password=\"\"\n",
    "for i in range(length):\n",
    "    password += random.choice(characters)\n",
    "print (password)"
